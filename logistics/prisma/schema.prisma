// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FacilityType {
  MegaGateway        @map("mega_gateway")
  DistributionCenter @map("distribution_center")
  LocalBranch        @map("local_branch")
}

enum CourierStatus {
  Available @map("available")
  Busy      @map("busy")
  Offline   @map("offline")
}

enum UserRole {
  Admin    @map("admin")
  Manager  @map("manager")
  Clerk    @map("clerk")
  Courier  @map("courier")
  Customer @map("customer")
}

enum HandoffType {
  CourierPickup @map("courier_pickup")
  SenderDropoff @map("sender_dropoff")
}

enum ParcelStatus {
  // First-Mile Lifecycle
  PendingPickup           @map("pending_pickup")
  ReadyForPickup          @map("ready_for_pickup")
  PickedUp                @map("picked_up")
  ArrivedAtOriginHub      @map("arrived_at_origin_hub")
  DepartedFromOriginHub   @map("departed_from_origin_hub")

  // Mid-Mile Lifecycle
  ArrivedAtHub            @map("arrived_at_hub")
  Sorting                 @map("sorting")
  Bagged                  @map("bagged")
  DepartedFromHub         @map("departed_from_hub")          // For Ancestors of Local Branch
  ArrivedAtDestinationHub @map("arrived_at_destination_hub")

  // Last-Mile Lifecycle
  OutForDelivery          @map("out_for_delivery")
  Delivered               @map("delivered")
  FailedDelivery          @map("failed_delivery")
  Rejected                @map("rejected")

  @@map("parcel_status")
}

enum ShippingServiceType {
  R @map("regular")
  E @map("express")
  B @map("bulky")
}

enum TransitMode {
  LandShuttle     @map("land_shuttle")     // Micro vertical hops (Branch -> Regional)
  HighwayLinehaul @map("highway_linehaul") // Macro overland highways (North Luzon -> South Luzon)
  MaritimeRoro    @map("maritime_roro")    // Inter-island ferry crossing (Cebu -> Luzon)
  AirFreight      @map("air_freight")

  @@map("transit_mode")
}

enum VehicleType {
  Van        @map("van")
  Truck      @map("truck")
  Motorcycle @map("motorcycle")
}

enum PhysicalVehicleStatus {
  Available   @map("available")
  InTransit   @map("in_transit")
  Maintenance @map("maintenance")
}

enum MasterBagStatus {
  Open       @map("open")
  Full       @map("full")
  Sealed     @map("sealed")
  Dispatched @map("dispatched")
  Delivered  @map("delivered")
  Unbagged   @map("unbagged")
}

enum SortingBatchStatus {
  Scheduled @map("scheduled")
  Active    @map("active")
  Completed @map("completed")
  Cancelled @map("cancelled")
}

enum ManifestStatus {
  Scheduled    @map("scheduled")
  Dispatched   @map("dispatched")
  Accumulating @map("accumulating")
  Completed    @map("completed")
  Arrived      @map("arrived")
  Cancelled    @map("cancelled")
}

enum DeliveryStatus {
  Scheduled    @map("scheduled")
  Loading      @map("loading")
  Dispatched   @map("dispatched")
  Completed    @map("completed")
  Arrived      @map("arrived")
}

enum FleetTransportType {
  Accumulation @map("accumulation")
  LineHaul     @map("line_haul")
  Delivery     @map("delivery")
}

enum PipelineStatus {
  Incoming  @map("incoming")
  Arrived   @map("arrived")
  Departed  @map("departed")
}

model Region {
  id                     String               @id @db.VarChar(15)
  name                   String               @db.VarChar(100)
  code                   String               @db.VarChar(15)

  provinces              Province[]

  @@map("regions")
}

model Province {
  id                     String               @id @db.VarChar(15)
  name                   String               @db.VarChar(100)
  code                   String               @db.VarChar(15)

  regionId               String               @map("region_id")
  region                 Region               @relation(fields: [regionId], references: [id], onDelete: Restrict)

  cities                 City[]

  @@map("provinces")
}

model City {
  id                     String               @id @db.VarChar(15)
  name                   String               @db.VarChar(100)
  code                   String               @db.VarChar(15)

  provinceId             String?              @map("province_id")
  province               Province?            @relation(fields: [provinceId], references: [id], onDelete: Restrict)

  barangays              Barangay[]

  @@map("cities")
}

model Sector {
  id                     Int                  @id @default(autoincrement())
  code                   String               @db.VarChar(15) // REG-PROV-CIT-(2-Digit Alphanumeric) e.g., R03-BUL-SJD-01, R03-BUL-SJD-02, R03-BUL-PAM-01
  zone                   Unsupported("geometry(Polygon, 4326)")?

  facilityId             Int                  @map("facility_id")
  facility               Facility             @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  barangays              Barangay[]
  deliveries             Delivery[]
  manifests              Manifest[]
  originParcels          Parcel[]            @relation("OriginSector")
  currentparcels         Parcel[]            @relation("CurrentSector")
  destinationParcels     Parcel[]            @relation("DestinationSector")

  @@map("sectors")
}

model Barangay {
  id                     String               @id @db.VarChar(15)
  name                   String               @db.VarChar(100)
  code                   String               @db.VarChar(15)

  cityId                 String               @map("city_id")
  city                   City                 @relation(fields: [cityId], references: [id], onDelete: Restrict)

  sectorId               Int?                 @map("sector_id")
  sector                 Sector?              @relation(fields: [sectorId], references: [id], onDelete: Restrict)

  stores                 Store[]
  customers              Customer[]
  receivedParcels        Parcel[]

  @@map("barangays")
}

model Facility {
  id                     Int                  @id @default(autoincrement())
  name                   String               @db.VarChar(100)
  code                   String               @db.VarChar(15)
  address                String
  location               Unsupported("geometry(Point, 4326)")?

  type                   FacilityType

  parentId               Int?                 @map("parent_id")
  parent                 Facility?            @relation("FacilityHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children               Facility[]           @relation("FacilityHierarchy")

  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  sectors                Sector[]
  sourceLegs             NetworkLeg[]         @relation("SourceLegs")
  destinationLegs        NetworkLeg[]         @relation("DestinationLegs")
  vehicles               PhysicalVehicle[]
  users                  User[]
  sortingBatches         SortingBatch[]
  schedule               FacilitySchedule?
  currentMasterBags      MasterBag[]          @relation("CurrentMasterBag")
  nextMasterBags         MasterBag[]          @relation("NextMasterBag")
  currentParcels         Parcel[]             @relation("CurrentFacility")
  originParcels          Parcel[]             @relation("OriginFacility")
  destinationParcels     Parcel[]             @relation("DestinationFacility")
  parcelLogs             ParcelLog[]
  routingPipelines       ParcelFacilityPipeline[]
  fleetTransports        FleetTransport[]

  @@map("facilities")
}

model FacilitySchedule {
  id                     Int                  @id @default(autoincrement())

  facilityId             Int                  @unique @map("facility_id")
  facility               Facility             @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  openingTime            DateTime             @db.Time() @map("opening_time")
  closingTime            DateTime             @db.Time() @map("closing_time")

  cutOffTime             DateTime             @db.Time() @map("cut_off_time")

  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  @@map("facility_schedules")
}

model NetworkLeg {
  id                     Int                  @id @default(autoincrement())

  sourceFacilityId       Int                  @map("source_facility_id")
  sourceFacility         Facility             @relation("SourceLegs", fields: [sourceFacilityId], references: [id], onDelete: Restrict)

  destinationFacilityId  Int                  @map("destination_facility_id")
  destinationFacility    Facility             @relation("DestinationLegs", fields: [destinationFacilityId], references: [id], onDelete: Restrict)

  laneCode               String               @db.VarChar(20) @map("lane_code")  // e.g., "N-C-LZN", "CEB-LZN-RORO"
  route                  Unsupported("geometry(LineString, 4326)")
  distanceMtr            Int                  @map("distance_mtr")                // stored in meters
  vehicleProfile         String               @map("vehicle_profile")
  baseTransitDuration    Int                  @map("base_transit_duration")      // e.g., 3600 (in secords) 1 hour
  mode                   TransitMode

  cutOffTime             DateTime             @db.Time() @map("cut_off_time")

  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  fleetTransports        FleetTransport[]

  @@map("network_legs")
}

model FleetTransport {
  id                     Int                  @id @default(autoincrement())

  facilityId             Int                  @map("facility_id")
  facility               Facility             @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  courierId              Int?                 @map("courier_id")                 
  courier                Courier?             @relation(fields: [courierId], references: [id], onDelete: SetNull)

  vehicleId              Int                  @map("vehicle_id")
  vehicle                PhysicalVehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  networkLegId           Int?                 @map("network_leg_id")
  networkLeg             NetworkLeg?          @relation(fields: [networkLegId], references: [id], onDelete: Cascade)

  scheduledFor           FleetTransportType   @default(Accumulation)
  scheduledTime          DateTime             @map("scheduled_time")

  route                  Json?

  dispatchedAt           DateTime?            @map("dispatched_at")
  arrivedAt              DateTime?            @map("arrived_at")
  returnedAt             DateTime?            @map("returned_at")

  scheduledAt            DateTime             @default(now()) @map("scheduled_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  manifest               Manifest?
  masterBags             MasterBag[]
  delivery               Delivery?

  @@map("fleet_transports")
}

model SortingBatch {
  id                     Int                  @id @default(autoincrement())
  code                   String

  startTime              DateTime?            @map("start_time")
  endTime                DateTime?            @map("end_time")

  cutOffTime             DateTime             @db.Time() @map("cut_off_time")

  facilityId             Int                  @map("facility_id")
  facility               Facility             @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  status                 SortingBatchStatus   @default(Scheduled)

  completedAt            DateTime?            @map("completed_at")

  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  looseParcels           Parcel[]
  masterBags             MasterBag[]
  logs                   SortingBatchLog[]
  
  @@map("sorting_batches")
}

model SortingBatchLog {
  id                     Int                  @id @default(autoincrement())

  sortingBatchId         Int                  @map("sorting_batch_id")
  sortingBatch           SortingBatch         @relation(fields: [sortingBatchId], references: [id], onDelete: Restrict)

  status                 SortingBatchStatus   @default(Scheduled)
  description            String

  createdAt              DateTime             @default(now()) @map("created_at")

  @@map("sorting_batch_logs")
}

model MasterBag {
  id                     Int                  @id @default(autoincrement())
  code                   String               @unique @db.VarChar(50)

  sortingBatchId         Int                  @map("sorting_batch_id")
  sortingBatch           SortingBatch         @relation(fields: [sortingBatchId], references: [id], onDelete: Restrict)

  fleetTransportId      Int?                 @map("fleet_transport_id")
  fleetTransport        FleetTransport?      @relation(fields: [fleetTransportId], references: [id], onDelete: Restrict)

  currentFacilityId      Int                  @map("current_facility_id")
  currentFacility        Facility             @relation("CurrentMasterBag", fields: [currentFacilityId], references: [id], onDelete: Restrict)

  nextFacilityId         Int                  @map("next_facility_id")
  nextFacility           Facility             @relation("NextMasterBag", fields: [nextFacilityId], references: [id], onDelete: Restrict)

  totalWeight            Int                  @default(0) @map("total_weight")
  totalCbm               Float                @default(0.00) @map("total_cbm")
  totalParcels           Int                  @default(0) @map("total_parcels")

  status                 MasterBagStatus      @default(Open)

  sealedAt               DateTime?            @map("sealed_at")

  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  parcels                Parcel[]
  logs                   MasterBagLog[]

  @@map("master_bags")
}

model MasterBagLog {
  id                     Int                  @id @default(autoincrement())

  masterBagId            Int                  @map("master_bag_id")
  masterBag              MasterBag            @relation(fields: [masterBagId], references: [id], onDelete: Restrict)

  status                 MasterBagStatus      @default(Open)
  description            String

  createdAt              DateTime             @default(now()) @map("created_at")

  @@map("master_bag_logs")
}

model Delivery {
  id                     Int                  @id @default(autoincrement())

  sectorId               Int                  @map("sector_id")
  sector                 Sector               @relation(fields: [sectorId], references: [id], onDelete: Restrict)

  fleetTransportId       Int                  @unique @map("fleet_transport_id")
  fleetTransport         FleetTransport       @relation(fields: [fleetTransportId], references: [id], onDelete: Restrict)

  code                   String               @unique
  status                 DeliveryStatus       @default(Scheduled)

  // Live aggregated counters to quickly validate against VehicleProfile gates
  currentWeightGrams     Int                  @default(0)
  currentVolumeCbm       Float                @default(0.0)

  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  parcels                Parcel[]
  logs                   DeliveryLog[]

  @@map("deliveries")
}

model DeliveryLog {
  id                     BigInt                @id @default(autoincrement())

  deliveryId             Int                   @map("delivery_id")
  delivery               Delivery              @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  status                 DeliveryStatus        @default(Scheduled)

  recordedAt             DateTime              @default(now()) @map("recorded_at")

  createdAt              DateTime              @default(now()) @map("created_at")

  @@map("delivery_logs")
}

model User {
  id                     Int                  @id @default(autoincrement())

  firstName              String               @db.VarChar(100) @map("first_name")
  lastName               String               @db.VarChar(100) @map("last_name")

  email                  String               @unique
  password               String
  
  assignedFacilityId     Int?                 @map("assigned_facility_id")
  assignedFacility       Facility?            @relation(fields: [assignedFacilityId], references: [id], onDelete: Restrict)
  
  role                   UserRole             @default(Courier)
  
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  courier                Courier?
  customer               Customer?

  @@map("users")
}

model Courier {
  id                     Int                  @id @default(autoincrement())

  userId                 Int                  @unique @map("user_id")
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  phoneNumber            String               @db.VarChar(20) @unique @map("phone_number")
  vehicleType            String               @db.VarChar(50) @map("vehicle_type")
  status                 CourierStatus        @default(Available)

  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  parcels                Parcel[]
  parcelLogs             ParcelLog[]
  fleetTransports        FleetTransport[]
  logs                   CourierLog[]

  @@map("couriers")
}

model CourierLog {
  id                     BigInt               @id @default(autoincrement())

  courierId              Int                  @map("courier_id")
  courier                Courier              @relation(fields: [courierId], references: [id], onDelete: Restrict)

  status                 CourierStatus        @default(Available)

  loggedAt               DateTime             @default(now()) @map("loggedAt")

  createdAt              DateTime             @default(now()) @map("created_at")
  
  @@map("courier_logs")
}

model Client {
  id                     Int                  @id @default(autoincrement())
  name                   String               @unique

  apiKey                 String               @unique @map("api_key")
  apiSecret              String               @map("api_secret")

  webhookUrl             String               @map("webhook_url")
  webhookSecret          String               @map("webhook_secret")

  isActive               Boolean              @default(true) @map("is_active")

  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  trackingNumbers        TrackingNumber[]
  stores                 Store[]
  
  @@map("clients")
}

model TrackingNumber {
  id                    Int                   @id @default(autoincrement())
  number                String                @unique @db.VarChar(50)

  clientId              Int?                  @map("client_id")
  client                Client?               @relation(fields: [clientId], references: [id], onDelete: Restrict)

  isAssigned            Boolean               @default(false) @map("is_assigned")
  assignedAt            DateTime?             @map("assigned_at")

  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  parcel                Parcel?  

  @@map("tracking_numbers")
}

model Store {
  id                    Int                   @id @default(autoincrement())

  clientId              Int                   @map("client_id")
  client                Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)

  externalFacilityId    Int                   @map("external_facility_id") // E-Commerce Vendor Warehouse OR Fulfillment Center

  name                  String
  contactNumber         String                @map("contact_number")
  streetAddress         String                @map("street_address")
  barangayId            String                @map("barangay_id")
  barangay              Barangay              @relation(fields: [barangayId], references: [id], onDelete: Restrict)
  location              Unsupported("geometry(Point, 4326)")?

  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  parcels               Parcel[]

  @@unique([clientId, externalFacilityId])
  @@map("stores")
}

model Customer {
  id                    Int                   @id @default(autoincrement())

  userId                 Int                  @unique @map("user_id")
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  contactNumber         String
  streetAddress         String                @map("street_address")
  barangayId            String                @map("barangay_id")
  barangay              Barangay              @relation(fields: [barangayId], references: [id])
  location              Unsupported("geometry(Point, 4326)")?

  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  parcels               Parcel[]

  @@map("customers")
}

model Parcel {
  id                    Int                   @id @default(autoincrement())

  trackingNumber        String                @db.VarChar(50) @unique @map("tracking_number")
  trackingNumberRel     TrackingNumber        @relation(fields: [trackingNumber], references: [number], onDelete: Restrict)

  externalOrderId       String?               @unique @map("external_order_id")

  // Sender is EITHER a Store OR a Customer
  storeId               Int?                  @map("store_id")
  store                 Store?                @relation(fields: [storeId], references: [id], onDelete: Restrict)

  customerId            Int?                  @map("customer_id")
  customer              Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)

  weightGrams           Int                   @map("weight_grams")
  lengthCm              Float                 @map("length_cm")
  heightCm              Float                 @map("height_cm")
  widthCm               Float                 @map("width_cm")
  calculatedCbm         Float                 @map("calculated_cbm")
  declaredValue         Decimal               @db.Decimal(10, 2) @map("declared_value")

  shippingServiceType   ShippingServiceType   @default(R) @map("shipping_service_type")

  originSectorId        Int                   @map("origin_sector_id")
  originSector          Sector                @relation("OriginSector", fields: [originSectorId], references: [id], onDelete: Restrict)
  currentSectorId       Int?                  @map("current_sector_id")
  currentSector         Sector?               @relation("CurrentSector", fields: [currentSectorId], references: [id], onDelete: Restrict)
  destinationSectorId   Int                   @map("destination_sector_id")
  destinationSector     Sector                @relation("DestinationSector", fields: [destinationSectorId], references: [id], onDelete: Restrict)

  originFacilityId      Int?                  @map("origin_facility_id")
  originFacility        Facility?             @relation("OriginFacility", fields: [originFacilityId], references: [id], onDelete: Restrict)

  destinationFacilityId Int?                  @map("destination_facility_id")
  destinationFacility   Facility?             @relation("DestinationFacility", fields: [destinationFacilityId], references: [id], onDelete: Restrict)

  currentFacilityId     Int?                  @map("current_facility_id")
  currentFacility       Facility?             @relation("CurrentFacility", fields: [currentFacilityId], references: [id], onDelete: Restrict)

  sortingCodeCache      String                @db.VarChar(50) @map("sorting_code_cache")
  routingPipelineCache  String                @map("routing_pipeline_cache")

  recipientName         String                @map("recipient_name")
  recipientPhone        String                @map("recipient_phone")
  recipientAddress      String                @map("recipient_address")
  recipientBarangayId   String                @map("recipient_barangay_id")
  recipientBarangay     Barangay              @relation(fields: [recipientBarangayId], references: [id], onDelete: Restrict)
  recipientLocation     Unsupported("geometry(Point, 4326)")? @map("recipient_location")
  
  handoffType           HandoffType           @default(CourierPickup) @map("handoff_type")

  assignedCourierId     Int?                  @map("assigned_courier_id")
  assignedCourier       Courier?              @relation(fields: [assignedCourierId], references: [id], onDelete: SetNull)

  status                ParcelStatus        @default(PendingPickup)

  manifestId            Int?                  @map("manifest_id")
  manifest              Manifest?             @relation(fields: [manifestId], references: [id], onDelete: SetNull)

  masterBagId           Int?                  @map("master_bag_id")
  masterBag             MasterBag?            @relation(fields: [masterBagId], references: [id], onDelete: SetNull)

  // Tracks loose unbagged parcels for bulky cargo
  sortingBatchId        Int?                  @map("sorting_batch_id")
  sortingBatch          SortingBatch?         @relation(fields: [sortingBatchId], references: [id], onDelete: Restrict)

  auditLog              ParcelAuditLog?

  deliveryId            Int?                  @map("delivery_id")
  delivery              Delivery?             @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  routingPipelines      ParcelFacilityPipeline[]

  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  parcelLogs            ParcelLog[]

  @@map("parcels")
}

model ParcelLog {
  id                    Int                   @id @default(autoincrement())

  parcelId              Int                   @map("parcel_id")
  parcel                Parcel                @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  status                ParcelStatus
  description           String

  facilityId            Int?                  @map("facility_id")
  facility              Facility?             @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  
  courierId             Int?                  @map("courier_id")
  courier               Courier?              @relation(fields: [courierId], references: [id], onDelete: SetNull)
  
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  @@map("parcel_logs")
}

model ParcelAuditLog {
  id                    Int                   @id @default(autoincrement())

  parcelId              Int                   @unique @map("parcel_id")
  parcel                Parcel                @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  weightGrams           Int                   @map("weight_grams")
  lengthCm              Float                 @map("length_cm")
  heightCm              Float                 @map("height_cm")
  widthCm               Float                 @map("width_cm")
  calculatedCbm         Float                 @map("calculated_cbm")

  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  @@map("parcel_audit_logs")
}

model ParcelFacilityPipeline {
  id                    Int                   @id @default(autoincrement())

  parcelId              Int                   @map("parcel_id")
  parcel                Parcel                @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  facilityId            Int                   @map("facility_id")
  facility              Facility              @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  sequenceOrder         Int                   @default(1) @map("sequence_order") // 1: Origin/PAR, 2: MNL, 3: MAR
  status                PipelineStatus        @default(Incoming)

  arrivedAt             DateTime?             @map("arrived_at")
  departedAt            DateTime?             @map("departed_at")

  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  @@unique([parcelId, facilityId, status])
  @@map("parcel_facility_pipelines")
}

model VehicleProfile {
  id                     Int                   @id @default(autoincrement())

  brand                  String                @db.VarChar(50)                    // Mitsubishi
  modelName              String                @db.VarChar(50) @map("model_name") // L300
  variant                String                @db.VarChar(50)                    // Aluminum Van

  maxWeightCapacityG     Int                   @map("max_weight_capacity_g")      // 1000000 -> 1,000kg
  maxUsableVolumeCbm     Float                 @map("max_usable_volume_cbm")      // 3.3
  allocationVolumeTarget Float                 @map("allocation_volume_target")   // 0.75 -> 75% Utilization Target

  lengthMm               Int                   @map("length_mm")
  widthMm                Int                   @map("width_mm")
  heightMm               Int                   @map("height_mm")

  type                   VehicleType

  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  vehicles               PhysicalVehicle[]

  @@map("vehicle_profiles")
}

model PhysicalVehicle {
  id                     Int                   @id @default(autoincrement())

  vehicleProfileId       Int                   @map("vehicle_profile_id")
  vehicleProfile         VehicleProfile        @relation(fields: [vehicleProfileId], references: [id], onDelete: Restrict)

  assignedFacilityId     Int?                  @map("assigned_facility_id")
  assignedFacility       Facility?             @relation(fields: [assignedFacilityId], references: [id], onDelete: Restrict)

  status                 PhysicalVehicleStatus @default(Available)
  plateNumber            String                @db.VarChar(20) @unique @map("plate_number")

  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  fleetTransports        FleetTransport[]
  locationLogs           VehicleLocationLog[]
  logs                   PhysicalVehicleLog[]

  @@map("physical_vehicles")
}

model PhysicalVehicleLog {
  id                     Int                   @id @default(autoincrement())

  physicalVehicleId      Int                   @map("physical_vehicle_id")
  physicalVehicle        PhysicalVehicle       @relation(fields: [physicalVehicleId], references: [id], onDelete: Cascade)

  status                 PhysicalVehicleStatus @default(Available)
  loggedAt               DateTime              @default(now()) @map("logged_at")

  @@map("physical_vehicle_logs")
}

model Manifest {
  id                     Int                   @id @default(autoincrement())

  sectorId               Int                   @map("sector_id")
  sector                 Sector                @relation(fields: [sectorId], references: [id], onDelete: Restrict)

  fleetTransportId       Int                   @unique @map("fleet_transport_id")
  fleetTransport         FleetTransport        @relation(fields: [fleetTransportId], references: [id], onDelete: Restrict)

  code                   String                @unique // e.g., "MNF-20261005-001"
  status                 ManifestStatus        @default(Scheduled)

  currentWeightGrams     Int                   @default(0)
  currentVolumeCbm       Float                 @default(0.0)

  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  parcels                Parcel[]
  logs                   ManifestLog[]

  @@map("manifests")
}

model ManifestLog {
  id                     Int                   @id @default(autoincrement())

  manifestId             Int                   @map("manifest_id")
  manifest               Manifest              @relation(fields: [manifestId], references: [id], onDelete: Restrict)

  status                 ManifestStatus        @default(Scheduled)
  description            String

  recordedAt             DateTime              @default(now()) @map("recorded_at")

  createdAt              DateTime              @default(now()) @map("created_at")

  @@map("manifest_logs")
}

model VehicleLocationLog {
  id                     Int                @id @default(autoincrement())

  physicalVehicleId      Int                   @map("physical_vehicle_id")
  physicalVehicle        PhysicalVehicle       @relation(fields: [physicalVehicleId], references: [id], onDelete: Cascade)

  longitude              Float
  latitude               Float

  speed                  Float?          
  heading                Float?                // Direction (0-360 degrees)

  timestamp              DateTime              @default(now())

  // @@index([physicalVehicleId, timestamp(sort: Desc)]) // Fast querying for "latest" location
  @@map("vehicle_location_logs")
}